# CloakForge environment template — copy to .env.local for development (no real values here).
# Keep in sync with .env.template and src/lib/config/env.ts.
#
# Production runtimes (VERCEL_ENV=production, or NODE_ENV=production incl. Vercel Preview and
# `next start`) are validated at server boot by src/instrumentation.ts → validateEnv(). Every variable
# marked [required in prod] must be set, or the server refuses to start and logs the missing NAMES.
# `next build` is never blocked. In development, missing values fall back (devnet RPC, empty secrets)
# and a single warning is logged.

# ── Solana RPC ────────────────────────────────────────────────────────────────────────────────
# PUBLIC client RPC [required in prod, https]. NEXT_PUBLIC_* values are inlined into the browser
# bundle, so this API key is PUBLIC. It MUST be a separate Alchemy app from the server one, locked to
# the production domains (Alchemy → App → Security → Allowlist: allowed domains/origins) and with a
# monthly spend/compute cap. Never reuse RPC_PRIVATE_ENDPOINT or ALCHEMY_API_KEY here.
NEXT_PUBLIC_RPC_ENDPOINT=
# PRIVATE server RPC [required in prod, https]. Server-only key (separate Alchemy app).
RPC_PRIVATE_ENDPOINT=
# Optional cluster assertion: mainnet-beta | devnet | testnet. Both RPC URLs must match it.
# When unset, Vercel Production expects mainnet-beta; other runtimes require client/server to agree.
NEXT_PUBLIC_SOLANA_NETWORK=
# Server-only Alchemy key for the Prices API (optional; falls back to CoinGecko).
ALCHEMY_API_KEY=

# ── Pinata / IPFS ─────────────────────────────────────────────────────────────────────────────
# [required in prod]
IPFS_JWT=
# [required in prod] Dedicated gateway HOSTNAME only, e.g. example.mypinata.cloud (no https://).
IPFS_GATEWAY=
IPFS_TOKEN_IMAGES_GROUP_ID=
IPFS_JSON_METADATA_GROUP_ID=

# ── Fees ──────────────────────────────────────────────────────────────────────────────────────
# [required in prod] Base58 Solana public key that receives service fees.
FEE_WALLET_ADDRESS=
# [required in prod] The same fee wallet, exposed to the browser (public; inlined at BUILD time, so set
# it for builds too). Tool pages pin it when checking prepared transactions before the wallet signs:
# production builds refuse to sign when it is missing or invalid. Must equal FEE_WALLET_ADDRESS.
NEXT_PUBLIC_FEE_WALLET_ADDRESS=

# ── Contentful ────────────────────────────────────────────────────────────────────────────────
# [required in prod]
CONTENTFUL_SPACE_ID=
# Optional, defaults to master.
CONTENTFUL_ENVIRONMENT=
# [required in prod]
CONTENTFUL_ACCESS_TOKEN=
# [required in prod] Revalidation webhook secret (32+ random characters recommended).
# The Contentful webhook must send it as header `x-webhook-secret` (never as a ?secret= query param).
CONTENTFUL_REVALIDATE_SECRET=

# [required in prod] Secret for opaque coupon memos and per-coupon marker addresses in transactions
# (HMAC key, 32+ random characters). Coupon uses are counted on-chain from these, so rotating it
# restarts every coupon's usage count.
COUPON_MEMO_SECRET=

# ── Admin dashboard (/admin) ──────────────────────────────────────────────────────────────────
# Comma-separated base58 wallets allowed to use /admin. Use a dedicated admin wallet, not the fee
# wallet. If empty or no entry is a valid address, admin access is disabled (fail closed).
ADMIN_WALLET_ADDRESSES=
# Optional comma-separated host[:port] list that REPLACES the request host as the accepted Domain in
# the signed admin message. It must include every host admins use, with the port where one is used
# (e.g. www.cloakforge.app,localhost:3001). When empty, only the request host is accepted.
ADMIN_ALLOWED_DOMAINS=

# ── Better Stack log shipping (EU region, error-level only, pre-redacted) ─────────────────────
# Recommended in prod (a warning is logged when unset).
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_URL=

# ── Legal entity (Imprint / Privacy / Terms) — recommended in prod ─────────────────────────────
# A warning is logged when unset (or when LEGAL_CONTACT_EMAIL is not an email); boot is not blocked.
# e.g. "Company Name s.r.o.", "Business address, Prague, Czech Republic", IČO, legal@example.com
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_ICO=
LEGAL_CONTACT_EMAIL=

# ── Escape hatch ──────────────────────────────────────────────────────────────────────────────
# Set to true to skip boot validation (e.g. local `next start` or a Preview without secrets).
# Ignored on Vercel Production.
SKIP_ENV_VALIDATION=
