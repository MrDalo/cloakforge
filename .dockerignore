# Keep secrets, VCS data and local artefacts out of the Docker build context.

# Secrets / local env (pass build-time values with `docker build --secret`, runtime values with --env-file)
.env*

# VCS and editor / agent tooling
.git
.github
.gitattributes
.vscode
.claude
.worktrees
.mcp.json
*.md
graphify-out

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
coverage
*.tsbuildinfo
npm-debug.log*

# OS cruft
.DS_Store

# The image definition itself
Dockerfile
.dockerignore
