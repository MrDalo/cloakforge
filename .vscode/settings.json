{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.insertSpaces": false,
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.format.enable": false,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": false
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": false
  },

  // Performance: Exclude large folders from search and file watching
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/tsconfig.tsbuildinfo": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/package-lock.json": true,
    "**/.git": true,
    "**/*.md": false
  },
  "files.associations": {
    "*.md": "markdown"
  },

  // Explicitly disable TypeScript/JavaScript language features for markdown
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "typescript.validate.enable": false,
    "javascript.validate.enable": false
  },

  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.hg/store/**": true,
    "**/*.md": true,
    "**/docs/**": true
  },

  // TypeScript performance settings (aggressive)
  "typescript.tsserver.maxTsServerMemory": 8192,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.tsserver.useSyntaxServer": "auto",
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.tsserver.experimental.useVsCodeWatcher": true,

  // Disable analyzing non-TS files
  "typescript.validate.enable": true,
  "javascript.validate.enable": true,

  // Exclude markdown and documentation files from TypeScript analysis
  "typescript.tsserver.exclude": [
    "**/*.md",
    "**/docs/**",
    "**/*.mdx",
    "**/README.md",
    "**/.github/**",
    "**/TROUBLESHOOTING.md",
    "**/todo-optimizations.md",
    "**/prompt-structure.md"
  ],

  // Additional TypeScript exclusions
  "typescript.tsserver.log": "off",
  "typescript.surveys.enabled": false,

  // Limit what TypeScript watches
  "typescript.tsserver.watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriorityPolling",
    "synchronousWatchDirectory": false,
    "excludeDirectories": ["**/node_modules", "**/.next", "**/.git", "**/build", "**/dist", "**/docs"],
    "excludeFiles": ["**/*.md", "**/*.mdx"]
  },

  // VS Code 1.110 chat and agent settings
  "workbench.browser.enableChatTools": true,
  "chat.editMode.hidden": true,
  "chat.tips.enabled": true,
  "chat.exploreAgent.defaultModel": "claude-haiku-4.5",
  "chat.tools.terminal.simpleCollapsible": true,
  "chat.notifyWindowOnResponseReceived": "always",
  "chat.notifyWindowOnConfirmation": "always",
  "chat.tools.terminal.sandbox.enabled": true,
  "chat.tools.terminal.sandbox.network": {
    "allowTrustedDomains": true
  },
  "chat.tools.terminal.sandbox.macFileSystem": {
    "enabled": true
  },
  "inlineChat.renderMode": "line",
  "inlineChat.affordance": "editor",
  "accessibility.signals.chatUserActionRequired": "on",
  "accessibility.chat.showCheckmarks": true,

  // Auto AI co-author trailer for commits created in VS Code
  "git.addAICoAuthor": "chatAndAgent"
